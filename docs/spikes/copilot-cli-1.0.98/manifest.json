{
  "cli": {
    "package": "@github/copilot",
    "version": "1.0.98"
  },
  "probe_script": "scripts/probe-copilot-cli.sh",
  "record": "docs/spikes/0003-copilot-cli-protocol.md",
  "command_templates": {
    "fresh": [
      "copilot", "-p", "<PROMPT>",
      "--output-format", "json",
      "--allow-all-tools", "--no-ask-user",
      "--no-auto-update", "--no-remote", "--no-remote-export",
      "--disable-builtin-mcps", "--no-custom-instructions",
      "--secret-env-vars", "COPILOT_GITHUB_TOKEN",
      "--model", "<MODEL>", "--reasoning-effort", "<EFFORT>",
      "--session-id", "<COORDINATOR-UUID>"
    ],
    "resume": [
      "copilot", "-p", "<PROMPT>",
      "--output-format", "json",
      "--allow-all-tools", "--no-ask-user",
      "--no-auto-update", "--no-remote", "--no-remote-export",
      "--disable-builtin-mcps", "--no-custom-instructions",
      "--secret-env-vars", "COPILOT_GITHUB_TOKEN",
      "--model", "<MODEL>", "--reasoning-effort", "<EFFORT>",
      "--resume=<RECORDED-UUID>"
    ]
  },
  "probes": [
    {"name": "version", "evidence": "observed", "exit": 0, "stdout_contains": ["GitHub Copilot CLI 1.0.98."]},
    {"name": "platform", "evidence": "observed", "exit": 0, "stdout_contains": ["aarch64"]},
    {"name": "node-version", "evidence": "observed", "exit": 0, "stdout_contains": ["v22."]},
    {"name": "help", "evidence": "observed", "exit": 0, "fixture": "help.stdout", "stdout_contains": ["--output-format <format>", "--session-id <id>", "--no-custom-instructions", "--disable-builtin-mcps", "--no-remote-export"]},
    {"name": "help-environment", "evidence": "observed", "exit": 0, "stdout_contains": ["`COPILOT_HOME`", "`COPILOT_GITHUB_TOKEN`, `GH_TOKEN`, `GITHUB_TOKEN`", "`COPILOT_AUTO_UPDATE`"]},
    {"name": "help-config", "evidence": "observed", "exit": 0, "stdout_contains": ["`disableAllHooks`", "`model`"]},
    {"name": "command-login", "evidence": "observed", "exit": 0, "stdout_contains": ["\"Copilot Requests\" permission", "Classic personal access tokens (ghp_) are not supported."]},
    {"name": "command-skill", "evidence": "observed", "exit": 0, "stdout_contains": ["Personal  ~/.copilot/skills/ or ~/.agents/skills/"]},
    {"name": "command-mcp", "evidence": "observed", "exit": 0, "stdout_contains": ["Workspace  .mcp.json or .github/mcp.json"]},
    {"name": "fresh-missing-auth", "evidence": "observed", "exit": 1, "fixture": "fresh-missing-auth.stderr", "stdout_empty": true, "stderr_contains": ["Error: No authentication information found."]},
    {"name": "state-after-fresh", "evidence": "observed", "exit": 0, "stdout_contains": ["/copilot/session-state/00000000-0000-4000-8000-000000000001/workspace.yaml"], "stdout_excludes": ["events.jsonl"]},
    {"name": "fresh-workspace", "evidence": "observed", "exit": 0, "stdout_contains": ["id: 00000000-0000-4000-8000-000000000001", "cwd: /work"]},
    {"name": "fresh-retry-same-id", "evidence": "observed", "exit": 1, "stdout_empty": true, "stderr_contains": ["Error: No authentication information found."]},
    {"name": "loader-cache", "evidence": "observed", "exit": 0, "stdout_contains": ["1.0.98"]},
    {"name": "resume-existing", "evidence": "observed", "exit": 1, "stdout_empty": true, "stderr_contains": ["Error: No session, task, or name matched '00000000-0000-4000-8000-000000000001'."]},
    {"name": "resume-unknown", "evidence": "observed", "exit": 1, "fixture": "resume-unknown.stderr", "stdout_empty": true, "stderr_contains": ["Error: No session, task, or name matched '00000000-0000-4000-8000-0000000000ff'."]},
    {"name": "session-id-unknown-name", "evidence": "observed", "exit": 1, "fixture": "session-id-unknown-name.stderr", "stdout_empty": true, "stderr_contains": ["The value is not a valid UUID, so a new session cannot be created."]},
    {"name": "session-id-short-prefix", "evidence": "observed", "exit": 1, "stdout_empty": true, "stderr_contains": ["Error: No session or task matched '0000000'."]},
    {"name": "resume-ambiguous-prefix", "evidence": "observed", "exit": 1, "stdout_empty": true, "stderr_contains": ["Error: No session, task, or name matched 'aaaaaaa1'."]},
    {"name": "resume-bare-noninteractive", "evidence": "observed", "exit": 1, "stdout_empty": true, "stderr_contains": ["Error: No authentication information found."]},
    {"name": "resume-and-session-id", "evidence": "observed", "exit": 1, "stdout_empty": true, "stderr_contains": ["error: the argument '--resume [<value>]' cannot be used with '--session-id <id>'"]},
    {"name": "resume-corrupt", "evidence": "observed", "exit": 1, "fixture": "resume-corrupt.stderr", "stdout_empty": true, "stderr_contains": ["Error: No session, task, or name matched '00000000-0000-4000-8000-0000000000cc'."]},
    {"name": "effort-unsupported", "evidence": "observed", "exit": 1, "fixture": "effort-unsupported.stderr", "stdout_empty": true, "stderr_contains": ["error: invalid value 'extreme' for '--reasoning-effort <level>'", "[possible values: none, minimal, low, medium, high, xhigh, max]"]},
    {"name": "effort-max", "evidence": "observed", "exit": 1, "stdout_empty": true, "stderr_contains": ["Error: No authentication information found."]},
    {"name": "model-unknown", "evidence": "observed", "exit": 1, "stdout_empty": true, "stderr_contains": ["Error: No authentication information found."]},
    {"name": "output-format-unknown", "evidence": "observed", "exit": 1, "stdout_empty": true, "stderr_contains": ["error: invalid value 'yaml' for '--output-format <format>'"]},
    {"name": "fake-gh-token", "evidence": "observed", "exit": 1, "fixture": "fake-gh-token.stderr", "stdout_empty": true, "stderr_contains": ["Error: Authentication token found but could not be validated."]},
    {"name": "fake-gh-hosts", "evidence": "observed", "exit": 1, "stdout_empty": true, "stderr_contains": ["Error: No authentication information found."]},
    {"name": "instruction-list", "evidence": "observed", "exit": 0, "stdout_contains": ["AGENTS.md", "CLAUDE.md", ".github/copilot-instructions.md", ".github/instructions/planted.instructions.md"]},
    {"name": "instruction-list-isolated", "evidence": "observed", "exit": 0, "stdout_contains": ["AGENTS.md", "CLAUDE.md"]},
    {"name": "skill-list", "evidence": "observed", "exit": 0, "stdout_contains": ["repo-github-skill", "repo-claude-skill", "repo-agents-skill", "curated-factory-skill", "customize-cloud-agent", "github-pr-media"]},
    {"name": "skill-list-isolated", "evidence": "observed", "exit": 0, "stdout_contains": ["curated-factory-skill", "customize-cloud-agent", "github-pr-media"], "stdout_excludes": ["repo-github-skill", "repo-claude-skill", "repo-agents-skill"]},
    {"name": "mcp-list", "evidence": "observed", "exit": 0, "stdout_contains": ["No MCP servers configured."], "stdout_excludes": ["planted-workspace", "planted-github"]},
    {"name": "mcp-list-isolated", "evidence": "observed", "exit": 0, "stdout_contains": ["No MCP servers configured."]},
    {"name": "plugin-list", "evidence": "observed", "exit": 0, "stdout_contains": ["No plugins installed.", "github-copilot-browser (v0.0.3) [disabled]"], "stdout_excludes": ["planted-plugin"]},
    {"name": "planted-prompt", "evidence": "observed", "exit": 1, "stdout_empty": true, "stderr_contains": ["Error: No authentication information found."]},
    {"name": "hook-marker", "evidence": "observed", "exit": 0, "stdout_contains": ["hook-did-not-run"]},
    {"name": "recreated-resume", "evidence": "observed", "exit": 1, "stdout_empty": true, "stderr_contains": ["Error: No session, task, or name matched '00000000-0000-4000-8000-000000000001'."]},
    {"name": "state-final", "evidence": "observed", "exit": 0, "stdout_contains": ["/home/factory/.cache/copilot/pkg", "/copilot/skills/curated-factory-skill/SKILL.md"], "stdout_excludes": ["00000000-0000-4000-8000-0000000000ff", "factory/.copilot"]},
    {"name": "log-sample", "evidence": "observed", "exit": 0, "stdout_contains": ["Starting Copilot CLI: 1.0.98", "Node.js version: v24.20.0", "Cannot create session from empty events array", "Ignoring unknown top-level key(s) in user settings file \"/copilot/settings.json\": \"remote\"", "Failed to fetch release list"]}
  ],
  "live_probes": [
    {"name": "fresh-jsonl-identity-and-final-event", "status": "not-run", "blocker": "RB-1"},
    {"name": "resume-after-process-restart", "status": "not-run", "blocker": "RB-2"},
    {"name": "resume-after-worker-recreation", "status": "not-run", "blocker": "RB-2"},
    {"name": "resume-full-uuid-versus-name-and-summary", "status": "not-run", "blocker": "RB-2"},
    {"name": "resume-ambiguous-prefix-with-real-sessions", "status": "not-run", "blocker": "RB-2"},
    {"name": "resume-corrupt-events-log", "status": "not-run", "blocker": "RB-2"},
    {"name": "model-unknown-and-unentitled", "status": "not-run", "blocker": "RB-3"},
    {"name": "effort-honored-and-unsupported-per-model", "status": "not-run", "blocker": "RB-3"},
    {"name": "dedicated-token-has-no-repository-write", "status": "not-run", "blocker": "RB-4"},
    {"name": "token-expiry-and-refresh", "status": "not-run", "blocker": "RB-4"},
    {"name": "failure-shapes-auth-rate-policy-model", "status": "not-run", "blocker": "RB-5"},
    {"name": "unattended-permissions-under-enterprise-policy", "status": "not-run", "blocker": "RB-6"},
    {"name": "suppression-with-credential", "status": "not-run", "blocker": "RB-7"},
    {"name": "curated-skill-activation", "status": "not-run", "blocker": "RB-7"},
    {"name": "no-update-download-with-credential", "status": "not-run", "blocker": "RB-7"}
  ],
  "release_blockers": [
    {"id": "RB-1", "title": "JSONL fresh-session identity, final, and failure event shapes are not observed"},
    {"id": "RB-2", "title": "Exact resume of a real session after restart and worker recreation is not observed"},
    {"id": "RB-3", "title": "Model and effort honoring, rejection, and fallback are not observed"},
    {"id": "RB-4", "title": "Dedicated credential permission boundary and refresh are not proved"},
    {"id": "RB-5", "title": "Typed evidence for expired auth, rate limits, policy denial, and unavailable models is not observed"},
    {"id": "RB-6", "title": "Unattended permissions under enforced enterprise policy are not observed"},
    {"id": "RB-7", "title": "Runtime suppression and curated skill activation with a credential are not observed"},
    {"id": "RB-8", "title": "Built-in product telemetry has no documented opt-out for GitHub-hosted inference"}
  ]
}
