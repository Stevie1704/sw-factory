    {"id":"file:internal/factory/claim.go","type":"file","name":"claim.go","filePath":"internal/factory/claim.go","summary":"Implements repository label bootstrapping, issue claiming, run creation, and orthogonal stage/status transitions with durable persistence and GitHub status synchronization.","tags":["service","workflow","github","state-machine","persistence"],"complexity":"complex"},
    {"id":"file:internal/factory/draft_pr.go","type":"file","name":"draft_pr.go","filePath":"internal/factory/draft_pr.go","summary":"Advances accepted implementations through checkpointing, deterministic gates, branch pushing, and idempotent draft pull-request creation or regeneration.","tags":["service","workflow","pull-request","gates","git"],"complexity":"complex"},
    {"id":"file:internal/store/store.go","type":"file","name":"store.go","filePath":"internal/store/store.go","summary":"Provides the SQLite operational store for runs and harness invocations, including validation, schema migration, backups, duplicate reconciliation, and recovery-oriented queries.","tags":["service","persistence","database","migration","recovery"],"complexity":"complex","languageNotes":"Uses SQLite transactions and fixed-width UTC timestamps so textual ordering remains chronological."},

