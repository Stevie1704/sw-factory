    {"id":"function:internal/factory/claim.go:BootstrapLabels","type":"function","name":"BootstrapLabels","filePath":"internal/factory/claim.go","lineRange":[96,112],"summary":"Loads the configured repository and explicitly creates or verifies all factory-owned GitHub labels.","tags":["service","github","workflow"],"complexity":"moderate"},
    {"id":"function:internal/factory/claim.go:ClaimIssue","type":"function","name":"ClaimIssue","filePath":"internal/factory/claim.go","lineRange":[117,219],"summary":"Validates an eligible GitHub issue, freezes its specification, creates a worktree and run record, and applies the initial factory state.","tags":["service","workflow","github","persistence","git"],"complexity":"complex"},
    {"id":"function:internal/factory/claim.go:Transition","type":"function","name":"Transition","filePath":"internal/factory/claim.go","lineRange":[224,272],"summary":"Validates and persists a stage/status transition for the active run while updating its GitHub labels and status comment.","tags":["service","workflow","state-machine","github"],"complexity":"moderate"},
    {"id":"function:internal/factory/claim.go:applyStateTransition","type":"function","name":"applyStateTransition","filePath":"internal/factory/claim.go","lineRange":[278,312],"summary":"Coordinates external label and comment changes with run persistence, retrying transient storage failures and compensating edits when necessary.","tags":["workflow","github","persistence","error-handling"],"complexity":"moderate"},
    {"id":"function:internal/factory/claim.go:saveRunWithRetry","type":"function","name":"saveRunWithRetry","filePath":"internal/factory/claim.go","lineRange":[317,339],"summary":"Retries one run save after a short cancellable delay to tolerate transient SQLite contention.","tags":["persistence","retry-policy","concurrency"],"complexity":"moderate"},
