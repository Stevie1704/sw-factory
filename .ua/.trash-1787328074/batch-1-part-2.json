    {"id":"function:internal/factory/claim.go:openActiveRunStore","type":"function","name":"openActiveRunStore","filePath":"internal/factory/claim.go","lineRange":[376,387],"summary":"Opens a run-capable store and reads the repository's current active run through one shared selection path.","tags":["persistence","workflow","recovery"],"complexity":"moderate"},
    {"id":"function:internal/factory/claim.go:failClaim","type":"function","name":"failClaim","filePath":"internal/factory/claim.go","lineRange":[391,409],"summary":"Records a terminal claim failure and best-effort changes the issue label so a partial claim remains visible and retryable.","tags":["workflow","github","error-handling","recovery"],"complexity":"moderate"},
    {"id":"function:internal/factory/claim.go:replaceFactoryState","type":"function","name":"replaceFactoryState","filePath":"internal/factory/claim.go","lineRange":[472,489],"summary":"Replaces existing factory-owned issue state labels with the requested state while preserving unrelated labels.","tags":["github","workflow","state-machine"],"complexity":"moderate"},

