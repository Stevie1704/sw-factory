#!/usr/bin/env python3
"""Read a cmux surface and report what it is rendering.

Uses the cmux `terminal.replay` RPC, which returns the surface's render grid as
styled row spans. This gives objective evidence about layout and colour without
anyone reading the screen.
"""
import json
import subprocess
import sys


def replay(surface):
    out = subprocess.run(
        ["cmux", "rpc", "terminal.replay", json.dumps({"surface": surface})],
        capture_output=True, text=True, check=True,
    )
    return json.loads(out.stdout)


def render(grid):
    columns = grid["columns"]
    rows = {}
    for span in grid["row_spans"]:
        line = rows.setdefault(span["row"], {})
        for offset, char in enumerate(span["text"]):
            line[span["column"] + offset] = char
    lines = []
    for index in sorted(rows):
        line = rows[index]
        lines.append("".join(line.get(c, " ") for c in range(columns)).rstrip())
    return lines


def colour_summary(grid):
    styles = grid["styles"]
    explicit = [s for s in styles
                if s.get("foreground_source") != "default"
                or s.get("background_source") != "default"]
    palette = sorted({s["foreground"] for s in explicit})
    return len(styles), len(explicit), palette


def main():
    surface = sys.argv[1] if len(sys.argv) > 1 else "surface:1"
    grid = replay(surface)["render_grid"]
    lines = render(grid)
    total, explicit, palette = colour_summary(grid)

    print(f"surface {surface}: {grid['columns']} columns, {grid['rows']} rows, "
          f"screen={grid['active_screen']}")
    print(f"styles: {total} total, {explicit} with explicit colour")
    print(f"foreground colours in use: {', '.join(palette)}")
    box = sum(line.count(c) for line in lines for c in "╭╮╰╯│─═╌")
    print(f"box-drawing characters rendered: {box}")
    print("-" * 60)
    for line in lines:
        if line.strip():
            print(line)


if __name__ == "__main__":
    main()
